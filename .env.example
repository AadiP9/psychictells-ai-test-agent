# ── Which site to test (Multi-Site Support) ────────────────────────────────────
# Loads site_profiles/<name>.json. Leave unset (or set to "psychictells")
# for the default site. Can also be overridden per-run with:
#   python main.py --site my_other_site
SITE_PROFILE=psychictells

# ── User Account ─────────────────────────────────────────────────────────────
# Create an account on the target site, name it whatever you like.
USER_EMAIL=
USER_PASSWORD=
USER_NAME=

# ── Expert / Admin Panel (if the site has one) ─────────────────────────────────
EXPERT_EMAIL=
EXPERT_PASSWORD=

# ── Browser Settings ───────────────────────────────────────────────────────────
HEADLESS=true
SLOW_MO=80
TIMEOUT=15000

# ── AI / Gemini (optional) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-flash-latest

# ── Scheduler Notifications (optional) ─────────────────────────────────────────
NOTIFY_EMAIL=
NOTIFY_WEBHOOK=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
